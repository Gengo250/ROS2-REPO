<?xml version="1.0"?>
<package format="3">
  <name>amr_route_planner</name><version>0.1.0</version>
  <description>Warehouse graph route planning above the existing Nav2 stack; Nav2 remains the physical navigator.</description>
  <maintainer email="gengo@users.noreply.github.com">Gengo</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>ament_index_python</exec_depend>
  <exec_depend>amr_simulation</exec_depend><exec_depend>amr_description</exec_depend><exec_depend>amr_navigation</exec_depend>
  <exec_depend>nav2_msgs</exec_depend><exec_depend>nav_msgs</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend><exec_depend>tf2_ros_py</exec_depend><exec_depend>tf2_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend><exec_depend>python3-pil</exec_depend><exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
