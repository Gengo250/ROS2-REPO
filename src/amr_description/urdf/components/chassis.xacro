<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="bumper" params="side sign">
    <link name="bumper_${side}_link">
      <xacro:mesh_visual stem="bumper_${side}" material="accent"/>
      <collision><geometry><box size="${bumper_length} ${bumper_width} ${bumper_height}"/></geometry></collision>
      <xacro:box_inertial mass="${bumper_mass}" x="${bumper_length}" y="${bumper_width}" z="${bumper_height}"/>
    </link>
    <xacro:fixed_joint name="bumper_${side}_joint" parent="chassis_link" child="bumper_${side}_link"
                       xyz="${sign*bumper_x} 0 ${bumper_z-chassis_z}"/>
  </xacro:macro>
  <xacro:macro name="chassis" params="">
    <link name="chassis_link">
      <xacro:mesh_visual stem="chassis" material="graphite"/>
      <xacro:chassis_collision/>
      <!-- Prototype battery-dominated COM; inertia approximated by a uniform box about this COM. -->
      <xacro:box_inertial mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"
                          xyz="0 0 ${chassis_com_height-chassis_z}"/>
    </link>
    <xacro:fixed_joint name="base_to_chassis" parent="base_link" child="chassis_link" xyz="0 0 ${chassis_z}"/>
    <xacro:bumper side="front" sign="1"/>
    <xacro:bumper side="rear" sign="-1"/>
  </xacro:macro>
</robot>
