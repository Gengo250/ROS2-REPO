<?xml version="1.0"?>
<sdf version="1.9">
  <world name="amr_validation">
    <gravity>0 0 -9.81</gravity>
    <physics name="physics" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.22 0.27 0.32 1</background><shadows>true</shadows></scene>
    <light name="sun" type="directional"><pose>0 0 8 0 0 0</pose><direction>-0.3 0.2 -1</direction>
      <diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular><cast_shadows>true</cast_shadows>
    </light>
    <model name="ground"><static>true</static><link name="ground_link">
      <collision name="floor_collision"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision>
      <visual name="floor_visual"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
        <material><ambient>0.45 0.48 0.50 1</ambient><diffuse>0.45 0.48 0.50 1</diffuse></material>
      </visual>
    </link></model>
    <!-- A known obstacle gives a finite, checkable return for LiDAR and RGB-D. -->
    <model name="test_obstacle"><static>true</static><pose>3 0 0.5 0 0 0</pose><link name="box">
      <collision name="collision"><geometry><box><size>0.4 1.2 1</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.4 1.2 1</size></box></geometry>
        <material><ambient>0.05 0.48 0.55 1</ambient><diffuse>0.05 0.48 0.55 1</diffuse></material>
      </visual>
    </link></model>
  </world>
</sdf>
