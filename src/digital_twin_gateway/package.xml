<?xml version="1.0"?>
<package format="3">
  <name>digital_twin_gateway</name>
  <version>0.1.0</version>
  <description>Read-only ROS telemetry gateway for the warehouse Digital Twin.</description>
  <maintainer email="gengo@example.com">gengo</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>gz_transport_vendor</exec_depend>
  <exec_depend>gz_msgs_vendor</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>amr_simulation</exec_depend>
  <exec_depend>python3-fastapi</exec_depend>
  <exec_depend>python3-pydantic</exec_depend>
  <exec_depend>python3-uvicorn</exec_depend>
  <exec_depend>python3-websockets</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-pytest-asyncio</test_depend>
  <test_depend>python3-jsonschema</test_depend>
  <test_depend>python3-httpx</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
