<?xml version="1.0"?>
<package format="3">
  <name>amr_lite_sim</name>
  <version>0.1.0</version>
  <description>Lightweight, Gazebo-free simulation engine: kinematics, 2D LiDAR, workers, forklifts, obstacles.</description>
  <maintainer email="gengo@example.com">gengo</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>atlas_scene</exec_depend>
  <exec_depend>amr_lite_interfaces</exec_depend>
  <exec_depend>amr_description</exec_depend>
  <exec_depend>amr_navigation</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
