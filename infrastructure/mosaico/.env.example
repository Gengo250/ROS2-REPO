# Copy to .env (git-ignored, chmod 600) and fill in. Never commit .env or key/certificate files.
# Database password, delivered to both containers as a Docker secret (not as container env).
# An existing `metadata` volume keeps the password it was initialised with.
MOSAICO_DB_PASSWORD=
# Address and port where mosaicod is published. Loopback by default (local development).
# On a separate storage server publish on the LAN/VPN interface only, together with
# compose.remote.yaml (TLS + API keys). PostgreSQL is never published.
MOSAICO_BIND_ADDRESS=127.0.0.1
MOSAICO_PORT=6726
# compose.remote.yaml only: server certificate and private key files on the storage host.
# MOSAICO_TLS_CERT_FILE=./tls/server.crt
# MOSAICO_TLS_KEY_FILE=./tls/server.key
