{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "noUncheckedIndexedAccess": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true, "esModuleInterop": true, "skipLibCheck": true,
    "isolatedModules": true, "noEmit": true, "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts", "playwright.config.ts", "test"]
}
